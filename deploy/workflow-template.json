      "active": true,
      "input": {
        "entityType": "full_stack",
        "billingMetrics": "builtin:billing.full_stack_monitoring.usage_per_host,builtin:billing.runtime_vulnerability_analytics.usage_per_host"
      },
      "position": { "x": -2, "y": 3 },
      "predecessors": ["get_metric_bucket_usage"],
      "conditions": { "states": { "get_metric_bucket_usage": "OK" } },
      "retry": { "count": 2, "delay": 30 }
    },
