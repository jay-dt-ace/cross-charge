{
  "title": "Cross Charge Workflow",
  "description": "",
  "ownerType": "USER",
  "isPrivate": false,
  "schemaVersion": 3,
  "trigger": {
    "schedule": {
      "rule": null,
      "timezone": "Australia/Sydney",
      "isActive": true,
      "filterParameters": {},
      "segmentFilter": [],
      "trigger": {
        "type": "cron",
        "cron": "0 17 * * *"
      }
    }
  },
  "tasks": {
    "get_date_range": {
      "name": "get_date_range",
      "action": "my.cross.charge:get-date-range",
      "description": "Sets the billing date range. Leave target_date blank for yesterday, or set YYYY-MM-DD to backfill.",
      "input": {
        "target_date": ""
      },
      "position": { "x": 1, "y": 1 },
      "predecessors": []
    },
    "get_rate_card": {
      "name": "get_rate_card",
      "action": "my.cross.charge:get-rate-card",
      "description": "Gathers rate card data via Dynatrace accounts API. Requires Configuration.",
      "input": {
        "connectionId": "RATE_CARD_CONNECTION_ID"
      },
      "position": { "x": 0, "y": 1 },
      "predecessors": [],
      "retry": { "count": 2, "delay": 30 }
    },
    "get_metric_bucket_usage": {
      "name": "get_metric_bucket_usage",
      "action": "my.cross.charge:get-metric-bucket-usage",
      "description": "Gathers % of included host metrics that were billed.",
      "active": true,
      "input": {
        "from_time": "{{ result(\"get_date_range\").from_time }}",
        "to_time": "{{ result(\"get_date_range\").to_time }}"
      },
      "position": { "x": 0, "y": 2 },
      "predecessors": ["get_rate_card", "get_date_range"],
      "conditions": {
        "states": {
          "get_rate_card": "OK",
          "get_date_range": "OK"
        }
      }
    },
    "get_fs_hosts": {
      "name": "get_fs_hosts",
